# GPU marian trainer. CUDA 11.8 = first toolkit with Ada/sm_89 (RTX 4090) support
# AND compatible with marian @ e8a1a25 (CUDA 12 breaks that commit).
# nvcc compiles fine without a physical GPU, so this image can be built anywhere;
# the resulting /opt/marian-dev/build/marian binary also runs standalone on any
# cuda:11.8-runtime host with libboost/libprotobuf/libopenblas installed (that's
# how boxes relay one built binary instead of rebuilding — ~50 min saved).
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    build-essential cmake git ca-certificates \
    libboost-all-dev libprotobuf-dev protobuf-compiler libopenblas-dev \
    zlib1g-dev libbz2-dev liblzma-dev libicu-dev pkg-config \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN git clone https://github.com/marian-nmt/marian-dev.git \
 && cd marian-dev \
 && git checkout e8a1a2530fb84cbff7383302ebca393e5875c441 \
 && git submodule update --init --recursive
RUN cd marian-dev && mkdir build && cd build \
 && cmake .. -DUSE_SENTENCEPIECE=on -DUSE_FBGEMM=on -DCOMPILE_CPU=on -DCOMPILE_CUDA=on \
    -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda -DCMAKE_BUILD_TYPE=RelWithDebInfo
# Build the EXECUTABLE targets (underscored). Target `marian` is the static lib
# libmarian.a, NOT the trainer — `make marian` produces no binary.
RUN cd marian-dev/build && make -j"$(nproc)" marian_train marian_decoder marian_conv
